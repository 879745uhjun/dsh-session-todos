{
  "name": "dsh-session-todos",
  "version": "0.2.0",
  "description": "Per-session todo checkboxes in the workspace sidebar plus a dedicated Todo page that groups sessions as in progress, to do, and done.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todos",
    "tasks",
    "sessions",
    "checklist",
    "sidebar"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node test/host.test.mjs",
    "test:dom": "node test/dom.test.mjs"
  },
  "license": "MIT",
  "author": "879745uhjun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-session-todos.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-session-todos#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-session-todos/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
